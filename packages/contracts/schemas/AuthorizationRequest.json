{
  "$defs": {
    "Classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "Classification",
      "type": "string"
    },
    "ResourceReference": {
      "additionalProperties": false,
      "properties": {
        "asserted_classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Classification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "ResourceReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Untrusted input. No authenticated principal can be supplied here.",
  "properties": {
    "action": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "context": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Context",
      "type": "object"
    },
    "destination": {
      "anyOf": [
        {
          "maxLength": 254,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destination"
    },
    "provenance_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Provenance Refs",
      "type": "array"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "resource": {
      "$ref": "#/$defs/ResourceReference"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "session_id",
    "action",
    "resource"
  ],
  "title": "AuthorizationRequest",
  "type": "object"
}
