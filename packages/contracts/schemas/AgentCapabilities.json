      "items": {
        "type": "string"
      },
      "title": "Actions",
      "type": "array"
    },
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "resource_ids": {
      "items": {
        "type": "string"
      },
      "title": "Resource Ids",
      "type": "array"
