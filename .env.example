# Local development only. No usable credential is committed; see docs/policy-pdp.md.
AG_ENV=development
AG_SERVICE_NAME=agentguard-backend
AG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AG_POLICY_URL=http://127.0.0.1:8000
# Optional PDP client configuration. These do not enable MCP caller authentication.
# Supply a server-owned per-adapter credential and its matching resolved binding.
AG_POLICY_CREDENTIAL=
AG_POLICY_AGENT_ID=
AG_POLICY_ADAPTER_ID=
AG_POLICY_VERSION=pdp-v1
AG_POLICY_TIMEOUT_SECONDS=2.0
# The gateway app mounts the Streamable HTTP MCP transport at /mcp.
AG_MCP_TRANSPORT=streamable-http
# Optional, separate loopback-only archive demonstration. Setting this does not enable forwarding.
# AG_ARCHIVE_MCP_URL=http://127.0.0.1:8002/mcp
# Used only by Vite's development proxy. Never put credentials in VITE_* variables.
AG_BACKEND_URL=http://127.0.0.1:8000
# OPA and PDP settings. In file mode an empty context path cannot produce ALLOW.
AG_OPA_URL=http://127.0.0.1:8181
AG_OPA_DECISION_PATH=agentguard/authz/decision
AG_OPA_TIMEOUT_SECONDS=1.0
AG_OPA_POLICY_VERSION=pdp-v1
AG_PDP_CONTEXT_PATH=
AG_PDP_DECISION_TTL_SECONDS=5
# File remains the default for isolated development. PostgreSQL is opt-in.
AG_PDP_CONTEXT_BACKEND=file
AG_DATABASE_URL=
AG_DATABASE_TIMEOUT_SECONDS=3
# Required when enabling the Compose database profile; no default password is supplied.
AG_POSTGRES_PASSWORD=
